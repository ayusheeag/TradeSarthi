rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: marketCache
    // Document ID: {category} (e.g., INDIAN_EQUITY, US_EQUITY)
    // Fields:
    //   - stats: string (required, max 100000 chars) - JSON stringified array of market stats
    //   - suggestions: string (required, max 100000 chars) - JSON stringified array of AI trade suggestions
    //   - updatedAt: number (required, positive) - Timestamp of the last update
    //
    // ===============================================================

    // Helper Functions
    function hasOnlyAllowedFields(allowedFields) {
      return request.resource.data.keys().hasOnly(allowedFields);
    }
    
    function isValidMarketCache() {
      return hasOnlyAllowedFields(['stats', 'suggestions', 'updatedAt']) &&
             request.resource.data.stats is string &&
             request.resource.data.suggestions is string &&
             request.resource.data.updatedAt is number &&
             request.resource.data.updatedAt > 0;
    }

    match /marketCache/{category} {
      // Publicly readable to speed up first page load as requested by user
      allow read: if true;
      // Allow public writes but strictly validate the schema and size limits
      allow create: if isValidMarketCache();
      allow update: if isValidMarketCache() && (!('updatedAt' in resource.data) || request.resource.data.updatedAt > resource.data.updatedAt);
    }

    match /fundamental_analysis/{cacheKey} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAll(['analysis', 'timestamp']) &&
                            request.resource.data.timestamp is number;
    }

    match /news_cache/{cacheKey} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasAny(['events', 'actions', 'news']) &&
                            request.resource.data.timestamp is number;
    }
  }
}
